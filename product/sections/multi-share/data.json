{
  "_meta": {
    "models": {
      "circles": "ROSCA savings circles with multi-share configuration. Each circle can allow members to hold multiple shares of the base contribution amount.",
      "members": "Circle participants with their share allocations, payment history, and payout positions.",
      "shareRequests": "Requests from members to increase, decrease, or transfer their share holdings. These go through an approval workflow.",
      "shareHistory": "Historical timeline of all share allocation changes for audit and transparency.",
      "contributions": "Payment records for each cycle, showing share-based breakdowns of amounts due and paid.",
      "payouts": "Disbursement records showing share-proportional payout amounts and positions.",
      "shareWaitlist": "Queue of members waiting for shares when a circle has reached its maximum capacity.",
      "shareTransfers": "Requests to transfer shares from one member to another within the same circle.",
      "platformConfig": "Platform-wide settings for multi-share limits, Trust Score requirements, and feature toggles.",
      "platformMetrics": "Aggregated statistics about multi-share usage across the platform.",
      "complianceAlerts": "Flagged patterns and risk assessments for potential fraud or abuse detection.",
      "educationContent": "Onboarding materials, quiz questions, and contextual tips for multi-share members."
    },
    "relationships": [
      "Each Circle contains multiple Members (participants) with their share allocations",
      "Members can submit ShareRequests to change their share count",
      "ShareHistory tracks all changes to a member's shares over time",
      "Contributions are calculated based on member's current share count",
      "Payouts are proportional to the member's shares relative to total circle shares",
      "ShareWaitlist queues members when circle capacity is reached",
      "ShareTransfers link a sender and recipient member for share movement",
      "ComplianceAlerts reference specific members, circles, or patterns for investigation"
    ]
  },

