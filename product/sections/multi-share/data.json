  "educationContent": {
    "quizQuestions": [
      {
        "id": "quiz-001",
        "question": "If you hold 3 shares in a circle with CHF 500 base contribution, how much will you contribute each cycle?",
        "options": [
          { "id": "a", "text": "CHF 500", "isCorrect": false },
          { "id": "b", "text": "CHF 1,000", "isCorrect": false },
          { "id": "c", "text": "CHF 1,500", "isCorrect": true },
          { "id": "d", "text": "CHF 2,000", "isCorrect": false }
        ],
        "explanation": "Your contribution is calculated as: Number of shares × Base contribution. So 3 shares × CHF 500 = CHF 1,500 per cycle.",
        "category": "contribution_calculation"
      },
      {
        "id": "quiz-002",
        "question": "What happens to your payout if you hold multiple shares?",
        "options": [
          { "id": "a", "text": "It stays the same as everyone else", "isCorrect": false },
          { "id": "b", "text": "It increases proportionally to your share count", "isCorrect": true },
          { "id": "c", "text": "You receive multiple smaller payouts", "isCorrect": false },
          { "id": "d", "text": "You receive your payout faster", "isCorrect": false }
        ],
        "explanation": "Your payout is proportional to your shares. If you hold 3 of 15 total shares (20%), you receive 20% of the cycle pool.",
        "category": "payout_calculation"
      },
      {
        "id": "quiz-003",
        "question": "When can you request additional shares in a circle?",
        "options": [
          { "id": "a", "text": "Only when joining the circle", "isCorrect": false },
          { "id": "b", "text": "Anytime, but changes apply from the next cycle", "isCorrect": true },
          { "id": "c", "text": "Only after receiving your payout", "isCorrect": false },
          { "id": "d", "text": "Never - shares are fixed", "isCorrect": false }
        ],
        "explanation": "You can request additional shares at any time (unless locked). If approved, the change takes effect from the next cycle to maintain fair accounting.",
        "category": "share_requests"
      },
      {
        "id": "quiz-004",
        "question": "What is the Emergency Fund and how does it relate to shares?",
        "options": [
          { "id": "a", "text": "A savings bonus for members with more shares", "isCorrect": false },
          { "id": "b", "text": "A 1% contribution that covers defaults, scaled to your share count", "isCorrect": true },
          { "id": "c", "text": "An optional insurance you can purchase", "isCorrect": false },
          { "id": "d", "text": "A penalty fund for late payments", "isCorrect": false }
        ],
        "explanation": "The Emergency Fund is 1% of each contribution, used to cover missed payments. If you have 3 shares, you contribute 3× the base Emergency Fund amount.",
        "category": "emergency_fund"
      },
      {
        "id": "quiz-005",
        "question": "What happens if you can't afford your multi-share contribution due to financial hardship?",
        "options": [
          { "id": "a", "text": "You're immediately removed from the circle", "isCorrect": false },
          { "id": "b", "text": "You can request an emergency share reduction", "isCorrect": true },
          { "id": "c", "text": "The organizer pays for you", "isCorrect": false },
          { "id": "d", "text": "Your Trust Score is permanently ruined", "isCorrect": false }
        ],
        "explanation": "CircleUp offers emergency share reduction for documented hardship (job loss, medical issues, etc.). This allows you to reduce your commitment without defaulting.",
        "category": "emergency_reduction"
      }
    ],
