  "campaignUpdates": [
    {
      "id": "update-001",
      "campaignId": "campaign-001",
      "title": "We've reached 75% of our goal!",
      "content": "Thanks to your incredible generosity, we've now raised CHF 37,500 - 75% of our CHF 50,000 goal!\n\nSo far, we've been able to provide emergency grants to 8 members who lost their jobs in the recent tech layoffs. Each grant of CHF 3,000-5,000 has helped cover rent, insurance, and essential living expenses while they search for new positions.\n\nThe matching from TechCorp Foundation has been instrumental - every franc you donate is doubled!\n\nLet's push to reach our goal before the March deadline.",
      "media": [
        {
          "id": "update-media-001",
          "type": "image",
