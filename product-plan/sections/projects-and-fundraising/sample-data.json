    {
      "id": "update-002",
      "campaignId": "campaign-002",
      "title": "Architectural plans approved!",
      "content": "Great news! The city of Geneva has approved our renovation plans. Construction will begin in March 2026.\n\nWe're now 56% of the way to our goal. The accessibility improvements alone will cost CHF 45,000, so every contribution matters.\n\nCome visit the center this weekend to see the current space and the planned improvements. We'll have the architect's renderings on display.",
      "media": [
        {
          "id": "update-media-002",
