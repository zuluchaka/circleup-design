  "successStories": [
    {
      "id": "story-001",
      "authorId": "user-011",
      "authorName": "Aminata Coulibaly",
      "authorAvatar": "https://i.pravatar.cc/150?u=aminata",
      "authorLocation": "Geneva, Switzerland",
      "title": "From Renting to Homeowner",
      "summary": "How CircleUp helped me save for my first home down payment in just 2 years",
      "content": "When I moved to Switzerland, I thought owning a home was an impossible dream. The down payment requirements seemed insurmountable. Then a friend introduced me to CircleUp and the concept of tontines. I joined two circles and committed to consistent saving. The community support kept me motivated even when unexpected expenses came up. After 2 years, I had saved CHF 45,000 - enough for my apartment down payment. The trust score I built also helped me get a better mortgage rate. I'm now a proud homeowner, and I continue to participate in circles to help others achieve their dreams.",
      "category": "first_home",
      "amountSaved": 45000.00,
      "timeframe": "2 years",
      "circlesCompleted": 4,
      "featured": true,
      "status": "approved",
