      "shares": 32
    },
    {
      "id": "story-003",
      "authorId": "user-013",
      "authorName": "Fatima Diallo",
      "authorAvatar": "https://i.pravatar.cc/150?u=fatimad",
      "authorLocation": "Basel, Switzerland",
      "title": "Emergency Fund Saved My Family",
      "summary": "When medical bills hit, my CircleUp savings were there",
      "content": "Last year, my husband had an unexpected medical emergency. Even with insurance, we faced CHF 8,000 in out-of-pocket costs. I was terrified, but then I remembered my emergency fund built through CircleUp. The money was there when we needed it most. The circle organizer even rallied members to offer support. We got through the crisis without going into debt. Now I'm rebuilding my emergency fund and encouraging every woman I know to have savings they can access when life happens.",
      "category": "emergency_fund",
      "amountSaved": 8000.00,
      "timeframe": "18 months",
