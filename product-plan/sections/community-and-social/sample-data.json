      "mentorMatches": "Pairings between experienced savers (mentors) and newcomers (mentees) for guidance and support.",
      "accountabilityPartners": "Mutual partnerships where two members support each other's savings goals and track progress together.",
      "communityImpact": "Platform-wide and association-level statistics showing collective savings, members helped, and circles completed.",
      "successStories": "Member testimonials sharing how CircleUp helped them achieve financial goals, inspiring others in the community."
    },
    "relationships": [
      "Referrals link to the User who sent the invitation and track the referred person's journey",
      "UserBadges connect Users to the Badges they've earned",
      "LeaderboardEntries reference Users and can be filtered by Circle or Association",
      "ChallengeEnrollments link Users to SavingsChallenges they've joined",
      "MentorMatches pair two Users (mentor and mentee) together",
      "AccountabilityPartners pair two Users for mutual support",
      "SuccessStories are authored by Users and may reference Circles or Associations"
    ]
  },
