    },
    {
      "id": "story-002",
      "authorId": "user-012",
      "authorName": "Moustapha Niang",
      "authorAvatar": "https://i.pravatar.cc/150?u=moustapha",
      "authorLocation": "Zurich, Switzerland",
      "title": "Funding My Son's Education",
      "summary": "Community savings made my son's university education possible",
      "content": "University education in Switzerland is excellent but expensive for international students. I started saving in a CircleUp tontine when my son was 15, knowing he would need support in 3 years. The predictable payout schedule aligned perfectly with tuition deadlines. When the time came, I had CHF 32,000 ready. But more than the money, the circle taught my son about financial discipline. He now participates in his own student circle. CircleUp didn't just fund his education - it taught our family the power of community finance.",
      "category": "education",
      "amountSaved": 32000.00,
      "timeframe": "3 years",
      "circlesCompleted": 3,
      "featured": true,
      "status": "approved",
      "submittedAt": "2025-07-20T11:00:00Z",
