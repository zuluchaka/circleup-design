{
  "_meta": {
    "models": {
      "circles": "Each circle represents a ROSCA savings group where members contribute regularly and take turns receiving the pooled funds.",
      "participants": "Participants are the members of a circle, each with a payout position in the rotation and payment tracking stats.",
      "contributions": "Contributions are individual payments made by participants each cycle toward the pool.",
      "payouts": "Payouts are the lump sum disbursements given to the recipient for each cycle.",
      "emergencyFundInterventions": "Interventions occur when the Emergency Fund covers a missed contribution to protect the circle.",
      "positionSwapRequests": "Swap requests allow participants to trade payout positions with each other.",
      "bids": "Bids are submitted by participants in bidding circles to win earlier payout positions.",
      "disputes": "Disputes are conflicts between members that require organizer or platform resolution.",
      "memberRiskScores": "AI-predicted default risk scores help organizers assess prospective members.",
      "cashCollectionRecords": "Cash records document manual contributions collected by organizers from members without bank accounts.",
      "circleInvitations": "Invitations sent to prospective members to join a circle."
    },
    "relationships": [
      "Each Circle has multiple Participants who contribute and receive payouts",
      "Each Participant makes Contributions each cycle and receives one Payout during their turn",
      "Emergency Fund Interventions link to the defaulting Participant and the Contribution that was covered",
      "Position Swap Requests connect two Participants who want to trade payout positions",
      "Bids belong to a Participant and a specific cycle in a bidding Circle",
      "Disputes are filed by one Participant against another within a Circle",
      "Cash Collection Records are created by the Organizer for a specific Participant's Contribution"
    ]
  },
